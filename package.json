{
  "name": "fastapi-boilerplate-frontend",
  "private": false,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vitest run && tsc -b && vite build",
    "lint": "biome lint .",
    "lint:write": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "preview": "vite preview",
    "generate-routes": "tsr generate",
    "gen:api": "openapi-ts",
    "gen:api:bun": "OPENAPI_FILE=${VITE_API_URL_BUN}/openapi.json openapi-ts",
    "gen:api:watch": "openapi-ts --watch",
    "gen:api:check": "openapi-ts && git diff --exit-code src/client/",
    "knip": "knip",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "ci": "bun run check && bun run test",
    "ci:full": "bun run gen:api:check && bun run check && bun run test",
    "i18n:test": "bun run src/i18n-consistency.test.ts",
    "i18n:lint": "i18next-cli lint",
    "i18n:extract": "i18next-cli extract",
    "i18n:extract:watch": "i18next-cli extract --watch",
    "i18n:sync": "i18next-cli sync",
    "i18n:watch": "i18next-cli watch",
    "i18n:types": "i18next-cli types",
    "i18n:status": "i18next-cli status"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@marsidev/react-turnstile": "^1.5.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/ai-react": "^0.6.4",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-store": "^0.9.3",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.18.1",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.42.2",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.542.0",
    "react": "^19.2.7",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.7",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^15.7.4",
    "react-markdown": "^10.1.0",
    "react-top-loading-bar": "^3.0.2",
    "recharts": "^3.9.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@faker-js/faker": "^9.9.0",
    "@hey-api/client-axios": "^0.9.1",
    "@hey-api/openapi-ts": "^0.89.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "@tanstack/react-router-devtools": "^1.167.0",
    "@tanstack/router-cli": "^1.167.17",
    "@tanstack/router-plugin": "^1.168.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "i18next-cli": "^1.64.2",
    "jsdom": "^27.4.0",
    "knip": "^5.88.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.9"
  }
}
